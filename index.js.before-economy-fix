    }

    // Adminlarning xabariga mat filtri ishlamaydi
    if (await isAdmin(ctx)) {
      return next();
    }

    const text = (
      ctx.message?.text ||
      ctx.message?.caption ||
      ""
    ).toLowerCase();

    if (!text) {
      return next();
    }

    const found = badWords.some(
      word => text.includes(word)
    );

    if (!found) {
